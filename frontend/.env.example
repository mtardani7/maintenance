# Laravel base URL. Leave empty until the backend exposes an auth/API contract.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Session auth endpoints exposed by Laravel.
NEXT_PUBLIC_AUTH_ME_PATH=/api/me
NEXT_PUBLIC_AUTH_LOGIN_PATH=/api/login
NEXT_PUBLIC_AUTH_LOGOUT_PATH=/api/logout
NEXT_PUBLIC_CSRF_COOKIE_PATH=/api/csrf-cookie

# Phase 2 maintenance API paths. Values must match Laravel exactly.
NEXT_PUBLIC_MACHINES_PATH=
NEXT_PUBLIC_MACHINE_DETAIL_PATH_TEMPLATE=
NEXT_PUBLIC_MACHINE_INCIDENTS_PATH_TEMPLATE=
NEXT_PUBLIC_MACHINE_TICKETS_PATH_TEMPLATE=
NEXT_PUBLIC_MACHINE_QA_DEFECTS_PATH_TEMPLATE=
NEXT_PUBLIC_INCIDENTS_CREATE_PATH=
NEXT_PUBLIC_TICKETS_CREATE_PATH=

# Phase 3 ticket management paths. Values must match Laravel exactly.
NEXT_PUBLIC_TICKETS_PATH=/tickets
NEXT_PUBLIC_TICKET_DETAIL_PATH_TEMPLATE=/tickets/{ticket}
NEXT_PUBLIC_TICKET_ACTION_PATH_TEMPLATE=/tickets/{ticket}/actions/{action}
NEXT_PUBLIC_TICKET_STATS_PATH=

# Phase 4 notification and push paths. Values must match Laravel exactly.
NEXT_PUBLIC_NOTIFICATIONS_PATH=
NEXT_PUBLIC_NOTIFICATIONS_UNREAD_COUNT_PATH=
NEXT_PUBLIC_NOTIFICATION_READ_PATH_TEMPLATE=
NEXT_PUBLIC_NOTIFICATIONS_READ_ALL_PATH=
NEXT_PUBLIC_PUSH_SUBSCRIPTION_PATH=
# Public VAPID key only. Never place the private key in frontend variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Phase 5 QA integration paths. Values must match Laravel exactly.
NEXT_PUBLIC_QA_DEFECTS_PATH=
NEXT_PUBLIC_QA_DEFECT_DETAIL_PATH_TEMPLATE=
NEXT_PUBLIC_QA_DEFECT_TICKET_PATH_TEMPLATE=

# Phase 6 operational, reporting, SLA, workload, and analytics paths.
NEXT_PUBLIC_OPERATIONS_STATS_PATH=
NEXT_PUBLIC_OPERATIONS_ATTENTION_PATH=
NEXT_PUBLIC_SUPERVISOR_OVERVIEW_PATH=
NEXT_PUBLIC_REPORTS_METRICS_PATH=/reports/metrics
NEXT_PUBLIC_REPORTS_EXPORT_PATH=/reports/export
NEXT_PUBLIC_MACHINE_ANALYTICS_PATH_TEMPLATE=
